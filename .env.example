# Dominio completo del negozio, senza https://.
# Esempio SHINELUX: shinelux.myshopify.com
# Non aggiungere .myshopify.com se c'è già: lo script non lo aggiunge un'altra volta.
SHOPIFY_SHOP=your-store.myshopify.com

# Dev Dashboard → Settings dell'app. Lo script chiede da solo il token a ogni esecuzione.
# Il token dura 24 ore. Non incollare qui un token shpat_.
SHOPIFY_CLIENT_ID=your_client_id
SHOPIFY_CLIENT_SECRET=your_client_secret

# Solo se NON usi Client ID e Client secret e hai già un token Admin permanente.
# Lascia vuoto (o non crearlo) quando usi il Dev Dashboard.
# SHOPIFY_ADMIN_ACCESS_TOKEN=

# Versione stabile Admin GraphQL. Ottobre 2026: 2026-10.
SHOPIFY_API_VERSION=2026-10

# Finestra inclusiva sulla data di creazione del cliente (ISO 8601, UTC).
# Una data senza orario vale l'intera giornata UTC.
START_DATE=2026-01-01T00:00:00Z
END_DATE=2027-12-31T23:59:59Z

# Tag che il modulo (Shopify Forms, un Flow, o l'app di iscrizione) deve già
# aver messo sul cliente. Chi non ha questo tag viene saltato.
# Scrivi - solo se non usi un tag e filtri soltanto con CUSTOMER_QUERY_EXTRA.
EARLY_ACCESS_SOURCE_TAG=form-early-access

# Tag che riempie il segmento clienti. Deve essere esattamente questo, spazi compresi.
TARGET_TAG=early access targa

# Opzionale. Frammento di ricerca clienti Shopify, unito con AND al resto.
# Esempi validi: tag:'lista-vip'   email:*@tuodominio.com   country:IT
# Lascia vuoto se ti basta il tag del modulo.
CUSTOMER_QUERY_EXTRA=
